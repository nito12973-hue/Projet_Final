# ==============================================================================
# Configuration Environnementale - SantéSN (Production / Docker)
# ==============================================================================
# Copiez ce fichier vers .env :
#   cp .env.docker.example .env
# et renseignez les valeurs secrètes de votre serveur.

# --- SÉCURITÉ DJANGO ---
# Générez une clé secrète robuste (ex: python -c 'import secrets; print(secrets.token_urlsafe(50))')
SECRET_KEY=changez-moi-en-production-cle-secrete-tres-longue-et-securisee
DEBUG=False
# Liste des domaines / IP autorisés séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1,projet-final-bice.vercel.app,santesn.sn,www.santesn.sn

# --- BASE DE DONNÉES POSTGRESQL (DOCKER) ---
DB_NAME=santesn_db
DB_USER=santesn_user
DB_PASSWORD=mot_de_passe_robuste_db_a_definir
DB_HOST=db
DB_PORT=5432

# --- SCELLEMENT CRYPTOGRAPHIQUE DES ORDONNANCES (ANTI-FRAUDE) ---
# Clé HMAC secrète dédiée pour le scellement numérique des ordonnances médicales
ORDONNANCE_SCEAU_CLE=cle-secrete-hmac-pour-signature-ordonnances-a-proteger-rigoureusement

# --- SÉCURITÉ HTTPS & COOKIES ---
# Activer à True si Nginx est configuré avec un certificat SSL/TLS (recommandé en production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://projet-final-bice.vercel.app,https://santesn.sn

# --- CONFIGURATION DU SERVEUR NGINX / GUNICORN ---
WEB_PORT=80
GUNICORN_WORKERS=3
